# Contenedores del sistema (descripción + tecnología obligatorias)
app = container "Aplicación Web" "Describa la responsabilidad." "React · Vite · SPA" "Frontend,WebBrowser"
api = container "API" "Describa la responsabilidad." "Python · FastAPI · Cloud Run" "BFF"
db = container "Base de Datos" "Describa los datos que almacena." "PostgreSQL · Cloud SQL" "Database"
