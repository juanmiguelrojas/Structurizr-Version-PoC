@startuml
set separator none
title System Landscape

left to right direction

!include <C4/C4>
!include <C4/C4_Context>

AddBoundaryTag("API Management (terpel-gtic-apigee)", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_1, "API Management (terpel-gtic-apigee)", $tags="API Management (terpel-gtic-apigee)") {
  System(ApigeeAPIGateway, "Apigee API Gateway", $descr="Plataforma de administración de APIs nativa de GCP (Proxy instance + Gateway). Valida firma/issuer/audience del JWT contra el JWKS de Entra ID, aplica cuotas y políticas.", $tags="", $link="")
}

AddBoundaryTag("Borde y Red Corporativa (terpel-infra-vpc-transversal)", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_2, "Borde y Red Corporativa (terpel-infra-vpc-transversal)", $tags="Borde y Red Corporativa (terpel-infra-vpc-transversal)") {
  System(FirewallPaloAlto, "Firewall Palo Alto", $descr="Firewall de red que inspecciona y controla el tráfico de entrada y salida, aplicando políticas de seguridad y NAT.", $tags="", $link="")
  System(InternalLoadBalancer, "Internal Load Balancer", $descr="GCP Cloud Load Balancing interno. Re-cifra TLS y enruta hacia la instancia proxy de Apigee y hacia los BFF en Cloud Run.", $tags="", $link="")
  System(Cloudflare, "Cloudflare", $descr="Plataforma de protección de tráfico (WAF, DDoS) y CDN para el acceso web desde red pública. DNS apunta a la IP del LB externo (pass-through).", $tags="", $link="")
  System(ZTNANetskope, "ZTNA Netskope", $descr="Acceso Zero Trust para dispositivos gestionados: posture check (Intune), GlobalProtect/Zscaler, split tunneling controlado. Único camino de red de la app móvil.", $tags="", $link="")
  System(ExternalRegionalLoadBalancer, "External Regional Load Balancer", $descr="GCP Cloud Load Balancing externo. Termina SSL/TLS en el borde y enruta hacia el firewall corporativo.", $tags="", $link="")
}

AddBoundaryTag("Datos y Analítica Corporativa", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_3, "Datos y Analítica Corporativa", $tags="Datos y Analítica Corporativa") {
  System(DatalakeBigQuery, "Datalake BigQuery", $descr="Repositorio analítico corporativo de datos tabulares. Recibe información transformada por los ETL (Cloud Data Fusion).", $tags="", $link="")
  System(CloudDataFusion, "Cloud Data Fusion", $descr="Integración de datos (ETL) e ingesta al datalake corporativo.", $tags="", $link="")
}

AddBoundaryTag("Ecosistema de Portales (Referencia L0)", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_4, "Ecosistema de Portales (Referencia L0)", $tags="Ecosistema de Portales (Referencia L0)") {
  System(HUBCorporativoPortal, "HUB Corporativo (Portal)", $descr="Portal interno/externo de referencia (L0): wiki de conocimiento, catálogo de web apps, SSO federado y shell MFE. Comparte la plataforma transversal con Volarte.", $tags="", $link="")
  System(PowerBIService, "Power BI Service", $descr="Servicio de BI de Microsoft (Embed API, REST API, dashboards y reports) consumido por el HUB vía Power BI Proxy.", $tags="", $link="")
}

AddBoundaryTag("Identidad", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_5, "Identidad", $tags="Identidad") {
  System(MicrosoftEntraID, "Microsoft Entra ID", $descr="Proveedor de identidad corporativo (empleados y operarios). SSO · MFA · RBAC por grupos. OIDC / OAuth 2.0 + PKCE. Transversal al hub.", $tags="", $link="")
  System(CIAMPingIdentity, "CIAM Ping Identity", $descr="Gestiona identidad y acceso de usuarios externos: autenticación, autorización, registro y ciclo de vida de identidades.", $tags="", $link="")
}

AddBoundaryTag("Observabilidad", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_6, "Observabilidad", $tags="Observabilidad") {
  System(OTelCollector, "OTel Collector", $descr="OpenTelemetry Collector (Cloud Run). Recibe OTLP gRPC/HTTP, enmascara datos personales y exporta trazas, métricas y logs a Dynatrace (estrategia 'OTel First').", $tags="", $link="")
  System(DynatraceTenantTerpel, "Dynatrace (Tenant Terpel)", $descr="Fuente única de verdad corporativa de observabilidad: APM, Infra Monitoring, DEM/RUM, RASP y Business Analytics.", $tags="", $link="")
  System(GCPCloudLogging, "GCP Cloud Logging", $descr="Logs centralizados y audit logs (IAP, Secret Manager, KMS). Retención configurable y alertas.", $tags="", $link="")
  System(GCPCloudMonitoring, "GCP Cloud Monitoring", $descr="Métricas de Cloud Run, alertas de errores/latencia, dashboards, uptime checks y SLO tracking.", $tags="", $link="")
}

AddBoundaryTag("Seguridad Transversal", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_7, "Seguridad Transversal", $tags="Seguridad Transversal") {
  System(GCPSecretManager, "GCP Secret Manager", $descr="Almacena secretos de todos los servicios (credenciales DB, API keys, client secrets). Acceso vía Service Account (IAM). Rotación automática y audit log.", $tags="", $link="")
  System(CloudKMS, "Cloud KMS", $descr="Gestión de llaves de cifrado (CMEK, HSM, rotación). Cifra Cloud SQL, GCS, Firestore y los secretos de Secret Manager.", $tags="", $link="")
}

AddBoundaryTag("Sistemas Transaccionales Corporativos", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
Boundary(group_8, "Sistemas Transaccionales Corporativos", $tags="Sistemas Transaccionales Corporativos") {
  System(SAPERP, "SAP ERP", $descr="ERP corporativo de Terpel.", $tags="", $link="")
  System(Salesforce, "Salesforce", $descr="Dato maestro de clientes.", $tags="", $link="")
  System(Zenput, "Zenput", $descr="Sistema corporativo referenciado en L0 (el Draw.io no trae descripción; pendiente de confirmar por Arquitectura).", $tags="", $link="")
  System(GuruSoft, "GuruSoft", $descr="Servicio externo de facturación electrónica.", $tags="", $link="")
  System(PriceProviderExterno, "PriceProvider Externo", $descr="Fuente autoritativa de precios de combustible (decisión P-072 PENDING). Volarte no inventa la fuente de precio.", $tags="", $link="")
  System(Skypredict, "Skypredict", $descr="Motor externo de recomendación/predicción usado por el servicio de Asignación/Optimización.", $tags="", $link="")
}

Person(EmpleadoInterno, "Empleado Interno", $descr="Usuario corporativo (tenant Terpel) que accede a Volarte vía web con SSO de Entra ID: comercial, supervisión y administración.", $tags="", $link="")
Person(UsuarioExterno, "Usuario Externo", $descr="Usuario que no está dentro del tenant de Terpel. Se autentica a través del CIAM (Ping Identity).", $tags="", $link="")
System(Volarte, "Volarte", $descr="Sistema de operación de abastecimiento: web (comercial, supervisión, admin) y app móvil offline-first para operarios en campo. Orquesta datos maestros, comercial, operación, asignación y publicación documental sobre GCP.", $tags="", $link="")
Person(OperariodeEquipoAbastecedor, "Operario de Equipo Abastecedor", $descr="Único rol que usa la app móvil. Opera en campo (plataforma/rampa) con o sin cobertura de red.", $tags="", $link="")
Person(AdminDevTeam, "Admin / Dev Team", $descr="Gestiona módulos, publica versiones, administra permisos (GroupToRoleMapping) y monitorea el uso de la plataforma.", $tags="", $link="")

Rel(EmpleadoInterno, Volarte, "Accede a Volarte con SSO (navega, consulta, concilia)", $techn="HTTPS · TLS 1.3", $tags="", $link="")
Rel(UsuarioExterno, Volarte, "Accede a Volarte (portal externo)", $techn="HTTPS · TLS 1.3", $tags="", $link="")
