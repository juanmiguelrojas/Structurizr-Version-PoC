@startuml
set separator none
title Volarte - BFF Móvil - Components

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(InternalLoadBalancer, "Internal Load Balancer", $descr="GCP Cloud Load Balancing interno. Re-cifra TLS y enruta hacia la instancia proxy de Apigee y hacia los BFF en Cloud Run.", $tags="", $link="")
Container(Volarte.AppMóvil, "App Móvil", $techn="React Native · Android exclusivo", $descr="Offline-first: SQLite local (WatermelonDB) + cola de escritura con UUID por acción. Fotos/firma al filesystem local. Sync bidireccional al reconectar (delta + resumable upload). Solo operarios; distribución vía Intune / Managed Play. NO se despliega en GCP.", $tags="", $link="")
Container(Volarte.SvcDatosMaestros, "Svc: Datos Maestros", $techn="Python · FastAPI · Cloud Run", $descr="S02: Customer, AircraftOperator, AircraftType, AircraftRegistration, FuellingEquipment, NegotiationProfile, geocercas (HU-145).", $tags="", $link="")
Container(Volarte.SvcOperación, "Svc: Operación", $techn="Python · FastAPI · Cloud Run", $descr="S05: estado dinámico equipo/operador, turnos, posición e inventario de calidad. Suscriptor de tracking-eventos y conciliacion-resuelta.", $tags="", $link="")
ContainerQueue(Volarte.ColadeMensajería, "Cola de Mensajería", $techn="Google Cloud Pub/Sub", $descr="Pub/Sub. Topics: doc-publicacion (HU-055, retry + DLQ), operacion-cerrada (fan-out a 3 suscriptores), conciliacion-resuelta (HU-050) y tracking-eventos (ingesta asíncrona de alta frecuencia).", $tags="", $link="")
ContainerDb(Volarte.CloudSQL, "Cloud SQL", $techn="PostgreSQL · Cloud SQL", $descr="Base transaccional: usuarios, roles, registry, tablas operacionales, tablas de Sincronización (offline_actions_log) y metadata/numeración documental. Cifrado CMEK.", $tags="", $link="")
ContainerDb(Volarte.Memorystore, "Memorystore", $techn="Redis · Memorystore", $descr="Cache de sesiones, tokens, queries, decisiones de autorización (TTL corto) y llaves de idempotencia por UUID.", $tags="", $link="")
Container(Volarte.DocumentosGCS, "Documentos (GCS)", $techn="Google Cloud Storage", $descr="Almacenamiento WORM/versionado de documentos de entrega, fotos y firmas. Retención según política vigente. Recuperable por operación y cliente.", $tags="", $link="")

Container_Boundary("Volarte.BFFMóvil_boundary", "BFF Móvil", $tags="") {
  Component(Volarte.BFFMóvil.APIRouterControllers, "API Router / Controllers", $techn="FastAPI", $descr="Endpoints REST por feature (sync, delta, media). Punto de entrada del contenedor.", $tags="", $link="")
  Component(Volarte.BFFMóvil.MiddlewaredeAutenticación, "Middleware de Autenticación", $techn="JWT Middleware (FastAPI)", $descr="Valida issuer/audience/expiración del token (segunda validación tras Apigee).", $tags="", $link="")
  Component(Volarte.BFFMóvil.ServiciodeAutorización, "Servicio de Autorización", $techn="Python", $descr="Resuelve GroupToRoleMapping → Role/Permission/Capability.", $tags="", $link="")
  Component(Volarte.BFFMóvil.MotordeReconciliación, "Motor de Reconciliación", $techn="Python — regla HU-050", $descr="Regla HU-050: compara timestamp de captura vs. histórico de revocación. Auto-acepta o marca PENDING_REVIEW.", $tags="", $link="")
  Component(Volarte.BFFMóvil.ServiciodeIdempotencia, "Servicio de Idempotencia", $techn="Python + Redis", $descr="Evita procesar dos veces la misma acción reenviada (dedupe por UUID).", $tags="", $link="")
  Component(Volarte.BFFMóvil.ValidadordeOrdenSecuencia, "Validador de Orden / Secuencia", $techn="Python", $descr="Reordena acciones offline por timestamp de captura (no de llegada). Evita que una acción vieja reenviada tarde sobrescriba un estado más reciente.", $tags="", $link="")
  Component(Volarte.BFFMóvil.ProveedordeDelta, "Proveedor de Delta", $techn="Python — patrón HU-007", $descr="Versión + diferencias de catálogos/turnos para descarga incremental (patrón HU-007).", $tags="", $link="")
  Component(Volarte.BFFMóvil.ManejadordeSubida, "Manejador de Subida", $techn="GCS Resumable Upload", $descr="Orquesta la subida de fotos/firma tolerando cortes de red.", $tags="", $link="")
  Component(Volarte.BFFMóvil.PublicadordeEventos, "Publicador de Eventos", $techn="Pub/Sub Publisher", $descr="Publica operacion-cerrada y doc-publicacion.", $tags="", $link="")
  Component(Volarte.BFFMóvil.ClienteCloudSQL, "Cliente Cloud SQL", $techn="Cloud SQL Python Connector", $descr="Escribe la cola de acciones offline recibidas y el estado de conciliación (PENDIENTE / CONFIRMADO / PENDING_REVIEW) en tablas de Sincronización.", $tags="", $link="")
}

Rel(Volarte.BFFMóvil.MotordeReconciliación, Volarte.BFFMóvil.ManejadordeSubida, "Fotos / firma", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.MotordeReconciliación, Volarte.BFFMóvil.PublicadordeEventos, "Al cerrar operación", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ManejadordeSubida, Volarte.BFFMóvil.PublicadordeEventos, "Publica eventos de media", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.MotordeReconciliación, Volarte.BFFMóvil.ClienteCloudSQL, "Persiste offline_actions_log / PENDING_REVIEW", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(InternalLoadBalancer, Volarte.BFFMóvil.APIRouterControllers, "Resuelve peticiones Móviles (JWT ya validado por Apigee)", $techn="HTTPS · TLS", $tags="", $link="")
Rel(Volarte.AppMóvil, Volarte.BFFMóvil.APIRouterControllers, "Sync, delta y media (lógico: Netskope → Apigee → ILB)", $techn="REST/JSON · JWT · mTLS", $tags="", $link="")
Rel(Volarte.BFFMóvil.ServiciodeIdempotencia, Volarte.Memorystore, "Dedupe por UUID de acción", $techn="Redis RESP · TLS (in-transit encryption)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ServiciodeAutorización, Volarte.Memorystore, "Cache de decisión de autorización", $techn="Redis RESP · TLS (in-transit encryption)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ClienteCloudSQL, Volarte.CloudSQL, "Escribe / lee tablas de Sincronización", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil.ManejadordeSubida, Volarte.DocumentosGCS, "Resumable upload de fotos / firma", $techn="GCS JSON API · HTTPS", $tags="", $link="")
Rel(Volarte.BFFMóvil.PublicadordeEventos, Volarte.ColadeMensajería, "Publica cierre de operación", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil.ProveedordeDelta, Volarte.SvcOperación, "Obtiene turnos / estado operativo", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ProveedordeDelta, Volarte.SvcDatosMaestros, "Obtiene catálogos versionados", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.ColadeMensajería, Volarte.SvcOperación, "Push: finaliza / anula operación pendiente", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.SvcOperación, Volarte.SvcDatosMaestros, "Consulta geocerca (S02 / HU-145)", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.SvcOperación, Volarte.CloudSQL, "Lee / escribe tablas operacionales", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.SvcDatosMaestros, Volarte.CloudSQL, "Lee / escribe datos maestros", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil.APIRouterControllers, Volarte.BFFMóvil.MiddlewaredeAutenticación, "Valida", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.MiddlewaredeAutenticación, Volarte.BFFMóvil.ServiciodeAutorización, "Resuelve rol", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ServiciodeAutorización, Volarte.BFFMóvil.MotordeReconciliación, "Reconcilia", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.MotordeReconciliación, Volarte.BFFMóvil.ServiciodeIdempotencia, "Dedupe", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ServiciodeIdempotencia, Volarte.BFFMóvil.ValidadordeOrdenSecuencia, "Aplica en orden (timestamp de captura)", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.ValidadordeOrdenSecuencia, Volarte.BFFMóvil.MotordeReconciliación, "Secuencia validada", $techn="Llamada in-process (Python)", $tags="", $link="")
Rel(Volarte.BFFMóvil.MotordeReconciliación, Volarte.BFFMóvil.ProveedordeDelta, "Catálogos / turnos", $techn="Llamada in-process (Python)", $tags="", $link="")

SHOW_LEGEND(true)
@enduml