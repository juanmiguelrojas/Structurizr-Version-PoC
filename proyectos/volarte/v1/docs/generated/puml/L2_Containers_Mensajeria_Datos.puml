@startuml
set separator none
title Volarte - Containers

skinparam {
  defaultFontName "Open Sans"
}
left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System(DatalakeBigQuery, "Datalake BigQuery", $descr="Repositorio analítico corporativo de datos tabulares. Recibe información transformada por los ETL (Cloud Data Fusion).", $tags="", $link="")

System_Boundary("Volarte_boundary", "Volarte", $tags="") {
  AddBoundaryTag("Backends for Frontend", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_1, "Backends for Frontend", $tags="Backends for Frontend") {
    Container(Volarte.BFFWeb, "BFF Web", $techn="Python · FastAPI · Cloud Run", $descr="BFF — Backend Volarte. Valida JWT (issuer/audience, 2a validación), resuelve GroupToRoleMapping → Role/Permission/Capability y orquesta los servicios de dominio. Publica conciliacion-resuelta. Auto-scaling · pay-per-use.", $tags="", $link="")
    Container(Volarte.BFFMóvil, "BFF Móvil", $techn="Python · FastAPI · Cloud Run", $descr="Consumidor único: App móvil (operarios). Respuestas ultra-livianas, vistas exclusivas de operación en campo (no comparte payloads con BFF Web). Resuelve sync offline: delta + cola + reconciliación HU-050.", $tags="", $link="")
  }

  AddBoundaryTag("Datos", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_2, "Datos", $tags="Datos") {
    ContainerDb(Volarte.CloudSQL, "Cloud SQL", $techn="PostgreSQL · Cloud SQL", $descr="Base transaccional: usuarios, roles, registry, tablas operacionales, tablas de Sincronización (offline_actions_log) y metadata/numeración documental. Cifrado CMEK.", $tags="", $link="")
    ContainerDb(Volarte.Memorystore, "Memorystore", $techn="Redis · Memorystore", $descr="Cache de sesiones, tokens, queries, decisiones de autorización (TTL corto) y llaves de idempotencia por UUID.", $tags="", $link="")
    Container(Volarte.DocumentosGCS, "Documentos (GCS)", $techn="Google Cloud Storage", $descr="Almacenamiento WORM/versionado de documentos de entrega, fotos y firmas. Retención según política vigente. Recuperable por operación y cliente.", $tags="", $link="")
  }

  AddBoundaryTag("Mensajería", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_3, "Mensajería", $tags="Mensajería") {
    ContainerQueue(Volarte.ColadeMensajería, "Cola de Mensajería", $techn="Google Cloud Pub/Sub", $descr="Pub/Sub. Topics: doc-publicacion (HU-055, retry + DLQ), operacion-cerrada (fan-out a 3 suscriptores), conciliacion-resuelta (HU-050) y tracking-eventos (ingesta asíncrona de alta frecuencia).", $tags="", $link="")
  }

  AddBoundaryTag("Servicios de Dominio", $borderColor="#cccccc", $fontColor="#cccccc", $borderStyle="dashed")
  Boundary(group_4, "Servicios de Dominio", $tags="Servicios de Dominio") {
    Container(Volarte.SvcComercial, "Svc: Comercial", $techn="Python · FastAPI · Cloud Run", $descr="S04: elegibilidad, precio (PriceProvider) y crédito disponible. Suscriptor de operacion-cerrada para actualizar saldo/crédito.", $tags="", $link="")
    Container(Volarte.SvcOperación, "Svc: Operación", $techn="Python · FastAPI · Cloud Run", $descr="S05: estado dinámico equipo/operador, turnos, posición e inventario de calidad. Suscriptor de tracking-eventos y conciliacion-resuelta.", $tags="", $link="")
    Container(Volarte.GestorDocumental, "Gestor Documental", $techn="Python · FastAPI · Cloud Run", $descr="Publica el documento de entrega al cierre de operación y retorna un ID inmutable vinculado. Cola + reintento sin duplicar (HU-055). S07 define contenido y numeración del documento canónico; el Gestor solo lo publica.", $tags="", $link="")
  }

}

Rel(Volarte.BFFWeb, Volarte.Memorystore, "Cache de decisión de autorización", $techn="Redis RESP · TLS (in-transit encryption)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcComercial, "Consulta elegibilidad, precio y crédito", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcOperación, "Consulta estado de operación / turnos", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.CloudSQL, "Consultas varias (Proxy SQL)", $techn="Cloud SQL Auth Proxy · TLS", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.ColadeMensajería, "Publica resolución del supervisor (HU-050)", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.Memorystore, "Dedupe por UUID de acción", $techn="Redis RESP · TLS (in-transit encryption)", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.CloudSQL, "Escribe / lee tablas de Sincronización", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.DocumentosGCS, "Resumable upload de fotos / firma", $techn="GCS JSON API · HTTPS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.ColadeMensajería, "Publica cierre de operación", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.SvcOperación, "Obtiene turnos / estado operativo", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.ColadeMensajería, Volarte.GestorDocumental, "Push: dispara publicación documental", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.ColadeMensajería, Volarte.SvcComercial, "Push: actualiza saldo / crédito", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.ColadeMensajería, Volarte.SvcOperación, "Push: finaliza / anula operación pendiente", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.ColadeMensajería, DatalakeBigQuery, "Exporta eventos al datalake (BigQuery subscription)", $techn="Pub/Sub BigQuery subscription", $tags="", $link="")
Rel(Volarte.GestorDocumental, Volarte.CloudSQL, "Persiste número / metadata documental", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.GestorDocumental, Volarte.DocumentosGCS, "Sube documento final (único escritor)", $techn="GCS JSON API · HTTPS", $tags="", $link="")
Rel(Volarte.SvcOperación, Volarte.CloudSQL, "Lee / escribe tablas operacionales", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.SvcComercial, Volarte.CloudSQL, "Lee / escribe estado comercial", $techn="Cloud SQL Connector · TLS", $tags="", $link="")

SHOW_LEGEND(true)
@enduml