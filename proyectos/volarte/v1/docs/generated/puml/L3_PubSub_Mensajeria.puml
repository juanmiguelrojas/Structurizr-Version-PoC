@startuml
set separator none
title Volarte - Cola de Mensajería - Components

skinparam {
  defaultFontName "Open Sans"
}
left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Container(Volarte.BFFWeb, "BFF Web", $techn="Python · FastAPI · Cloud Run", $descr="BFF — Backend Volarte. Valida JWT (issuer/audience, 2a validación), resuelve GroupToRoleMapping → Role/Permission/Capability y orquesta los servicios de dominio. Publica conciliacion-resuelta. Auto-scaling · pay-per-use.", $tags="", $link="")
Container(Volarte.BFFMóvil, "BFF Móvil", $techn="Python · FastAPI · Cloud Run", $descr="Consumidor único: App móvil (operarios). Respuestas ultra-livianas, vistas exclusivas de operación en campo (no comparte payloads con BFF Web). Resuelve sync offline: delta + cola + reconciliación HU-050.", $tags="", $link="")
Container(Volarte.SvcComercial, "Svc: Comercial", $techn="Python · FastAPI · Cloud Run", $descr="S04: elegibilidad, precio (PriceProvider) y crédito disponible. Suscriptor de operacion-cerrada para actualizar saldo/crédito.", $tags="", $link="")
Container(Volarte.SvcOperación, "Svc: Operación", $techn="Python · FastAPI · Cloud Run", $descr="S05: estado dinámico equipo/operador, turnos, posición e inventario de calidad. Suscriptor de tracking-eventos y conciliacion-resuelta.", $tags="", $link="")
Container(Volarte.GestorDocumental, "Gestor Documental", $techn="Python · FastAPI · Cloud Run", $descr="Publica el documento de entrega al cierre de operación y retorna un ID inmutable vinculado. Cola + reintento sin duplicar (HU-055). S07 define contenido y numeración del documento canónico; el Gestor solo lo publica.", $tags="", $link="")

Container_Boundary("Volarte.ColadeMensajería_boundary", "Cola de Mensajería", $tags="") {
  ComponentQueue(Volarte.ColadeMensajería.Topicoperacioncerrada, "Topic: operacion-cerrada", $techn="Pub/Sub Topic", $descr="Se dispara al cerrar una operación en campo. Fan-out a 3 suscriptores.", $tags="", $link="")
  ComponentQueue(Volarte.ColadeMensajería.Topicconciliacionresuelta, "Topic: conciliacion-resuelta", $techn="Pub/Sub Topic", $descr="Se publica cuando un supervisor resuelve desde la Web una operación PENDING_REVIEW (HU-050): confirmar o anular.", $tags="", $link="")
  ComponentQueue(Volarte.ColadeMensajería.Topicdocpublicacion, "Topic: doc-publicacion", $techn="Pub/Sub Topic", $descr="Solicitudes de publicación documental (HU-055) con retry + DLQ.", $tags="", $link="")
  ComponentQueue(Volarte.ColadeMensajería.Topictrackingeventos, "Topic: tracking-eventos", $techn="Pub/Sub Topic", $descr="Ingesta asíncrona de alta frecuencia de eventos de tracking (posición de equipos).", $tags="", $link="")
  Component(Volarte.ColadeMensajería.Subgestordocumentalsub, "Sub: gestor-documental-sub", $techn="Push · retry + DLQ", $descr="Dispara generación y publicación del documento (HU-055).", $tags="", $link="")
  Component(Volarte.ColadeMensajería.Subcomercialsub, "Sub: comercial-sub", $techn="Push · retry + DLQ", $descr="Actualiza saldo/crédito tras el cierre de operación.", $tags="", $link="")
  Component(Volarte.ColadeMensajería.Suboperacionconciliacionsub, "Sub: operacion-conciliacion-sub", $techn="Push · retry + DLQ", $descr="Aplica la resolución (finaliza o anula) sobre la operación en tablas operacionales.", $tags="", $link="")
  Component(Volarte.ColadeMensajería.Subtrackingeventossub, "Sub: tracking-eventos-sub", $techn="Push · retry", $descr="Entrega eventos de tracking al Svc: Operación (si el topic está activo).", $tags="", $link="")
  ComponentQueue(Volarte.ColadeMensajería.DeadLetterTopic, "Dead Letter Topic", $techn="Pub/Sub DLQ", $descr="Mensajes que agotaron reintentos (5 intentos, backoff 10 s–600 s). Requiere revisión manual.", $tags="", $link="")
}

Rel(Volarte.ColadeMensajería.Topicoperacioncerrada, Volarte.ColadeMensajería.Subgestordocumentalsub, "Entrega", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Topicoperacioncerrada, Volarte.ColadeMensajería.Subcomercialsub, "Entrega", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Topicoperacioncerrada, Volarte.ColadeMensajería.Suboperacionconciliacionsub, "Entrega", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Topicdocpublicacion, Volarte.ColadeMensajería.Subgestordocumentalsub, "Entrega", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Topicconciliacionresuelta, Volarte.ColadeMensajería.Suboperacionconciliacionsub, "Entrega", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Topictrackingeventos, Volarte.ColadeMensajería.Subtrackingeventossub, "Entrega", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Subgestordocumentalsub, Volarte.ColadeMensajería.DeadLetterTopic, "Tras 5 reintentos (backoff 10s-600s)", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Subcomercialsub, Volarte.ColadeMensajería.DeadLetterTopic, "Tras 5 reintentos (backoff 10s-600s)", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Suboperacionconciliacionsub, Volarte.ColadeMensajería.DeadLetterTopic, "Tras 5 reintentos (backoff 10s-600s)", $techn="Pub/Sub delivery (at-least-once)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcComercial, "Consulta elegibilidad, precio y crédito", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcOperación, "Consulta estado de operación / turnos", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.ColadeMensajería.Topicconciliacionresuelta, "Publica resolución del supervisor (HU-050)", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.ColadeMensajería.Topicoperacioncerrada, "Publica cierre de operación", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.ColadeMensajería.Topicdocpublicacion, "Publica solicitud de documento", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.SvcOperación, "Obtiene turnos / estado operativo", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.ColadeMensajería.Topictrackingeventos, "Publica eventos de tracking de alta frecuencia", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Subgestordocumentalsub, Volarte.GestorDocumental, "Push: dispara publicación documental", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Subcomercialsub, Volarte.SvcComercial, "Push: actualiza saldo / crédito", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Suboperacionconciliacionsub, Volarte.SvcOperación, "Push: finaliza / anula operación pendiente", $techn="HTTPS push · OIDC token", $tags="", $link="")
Rel(Volarte.ColadeMensajería.Subtrackingeventossub, Volarte.SvcOperación, "Push: eventos de tracking", $techn="HTTPS push · OIDC token", $tags="", $link="")

SHOW_LEGEND(true)
@enduml