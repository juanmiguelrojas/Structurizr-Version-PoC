Rel(EmpleadoInterno, Portal.AppMóvil, "Accede desde la app en el movil por sso", $techn="", $tags="", $link="")
Rel(Portal.AppMóvil, DynatraceTenantTerpel, "RUM Agent", $techn="", $tags="", $link="")
