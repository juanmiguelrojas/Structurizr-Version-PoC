Rel(Portal.SvcNotificacion, Portal.SvcPagos, "Notifica", $techn="", $tags="", $link="")
Rel(Portal.SvcPagos, Portal.Colademensajeria, "Consume y publica topics", $techn="", $tags="", $link="")
Rel(Portal.Colademensajeria, Portal.SvcNotificacion, "Consume y publica topics", $techn="", $tags="", $link="")
Rel(Portal.BackendHUBWebMóvil, ApiGee, "gRPC / REST", $techn="", $tags="", $link="")
Rel(Portal.BackendHUBWebMóvil, Portal.MemorystoreRedisfree, "Redis SDK", $techn="", $tags="", $link="")
Rel(InternalLoadBalancer, Proxyinstance, "Enruta la comunicacion", $techn="", $tags="", $link="")
Rel(ApiGee, Proxyinstance, "Enruta la comunicacion", $techn="", $tags="", $link="")
