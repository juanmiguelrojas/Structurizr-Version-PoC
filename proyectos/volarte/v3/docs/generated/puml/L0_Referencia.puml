Rel(IdentityAwareProxyIAP, EntraIDCIAM, "OIDC redirect", $techn="", $tags="", $link="")
Rel(Portal.CloudLogging, Portal.CloudMonitoring, "Métricas · alertas", $techn="", $tags="", $link="")
Rel(SecretManager, CloudKMS, "Cifra secretos con CMEK", $techn="", $tags="", $link="")
Rel(Portal.CloudSQLPostgreSQL, CloudKMS, "Lee client secrets · IAM SA", $techn="", $tags="", $link="")
Rel(CloudKMS, Portal.Storage, "CMEK cifrado en reposo", $techn="", $tags="", $link="")
Rel(Portal.BackendHUBWeb, SecretManager, "Lee secretos · IAM SA", $techn="", $tags="", $link="")
Rel(Cloudflare, GlobalLoadBalancer, "Sync Red Publica", $techn="", $tags="", $link="")
Rel(Portal.PortalesRemoteModulo, Portal.FederationBridge, "Redirect + token hint", $techn="", $tags="", $link="")
Rel(Portal.HUBFront, Portal.PortalesRemoteModulo, "Enruta al modulo", $techn="", $tags="", $link="")
Rel(Portal.HUBFront, Portal.FederationBridge, "POST /federar {token, destino: "portal"}", $techn="", $tags="", $link="")
Rel(Portal.FederationBridge, PortalesExternosFuturos, "Redirect + JWT (token relay)", $techn="", $tags="", $link="")
Rel(Portal.SvcPowerBIProxy, PowerBIService, "Power BI REST API · AAD", $techn="", $tags="", $link="")
Rel(Portal.AppMóvil, EntraIDCIAM, "Verifica Autenticacion", $techn="", $tags="", $link="")
Rel(Portal.BackendHUBWebMóvil, InternalLoadBalancer, "", $techn="", $tags="", $link="")
Rel(Portal.SvcAnalitica, Datalake, "Fuente de datos/ Entrega de data", $techn="", $tags="", $link="")
Rel(Portal.SvcUsuariosAuth, ApiGee, "Expone", $techn="", $tags="", $link="")
Rel(Portal.SvcWiki, ApiGee, "Expone", $techn="", $tags="", $link="")
