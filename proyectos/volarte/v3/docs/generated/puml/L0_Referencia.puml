@startuml
set separator none
title L0 · Referencia — Vista global de integración

top to bottom direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(EmpleadoInterno, "Empleado Interno", $descr="Usuario corporativo que accede a la wiki, lanza web apps y navega a portales externos desde un único punto de entrada", $tags="", $link="")
Person(Usuarioexterno, "Usuario externo", $descr="Usuario que no esta dentro del tenant de terpel", $tags="", $link="")
System(ApiGee, "ApiGee", $descr="Plataforma de administración de API nativa de Google Cloud. Valida firma/issuer/audience del JWT contra el JWKS de Entra ID.", $tags="", $link="")
System(Firewall, "Firewall", $descr="Firewall de red encargado de inspeccionar y controlar el tráfico de entrada y salida, aplicando políticas de seguridad y NAT según las reglas definidas.", $tags="", $link="")
System(InternalLoadBalancer, "Internal Load Balancer", $descr="SSL/TLS terminado en el borde. Enrutamiento al IAP y Cloud Run.", $tags="", $link="")
System(Proxyinstance, "Proxy instance", $descr="Puente de conexion", $tags="", $link="")
System(Cloudflare, "Cloudflare", $descr="Plataforma de protección de tráfico y optimización de acceso web para servicios externos.", $tags="", $link="")
System(EntraIDCIAM, "EntraID / CIAM", $descr="Proveedor de identidad corporativo. SSO · MFA · RBAC. Transversal al hub", $tags="", $link="")
System(ZTNA, "ZTNA", $descr="GlobalProtect · Zscaler Device posture check · Intune Split tunneling controlado Solo acceso desde red corporativa", $tags="", $link="")
System(PortalesExternosFuturos, "+ Portales Externos Futuros", $descr="Cualquier portal que acepte federación SAML 2.0 / OIDC", $tags="", $link="")
System(GlobalLoadBalancer, "Global Load Balancer", $descr="SSL/TLS terminado en el borde. Enrutamiento al IAP y Cloud Run.", $tags="", $link="")
System(IdentityAwareProxyIAP, "Identity-Aware Proxy (IAP)", $descr="Capa de seguridad nativa GCP. Valida identidad antes de llegar a cualquier servicio interno. Integrado con EntraID via OIDC. Sin VPN requerida para el acceso web.", $tags="", $link="")
System(CloudKMS, "Cloud KMS", $descr="Gestión de claves de cifrado (CMEK). Cifra: Cloud SQL · GCS · Firestore. Cifra secretos en Secret Manager. HSM · rotación de claves.", $tags="", $link="")
System(SecretManager, "Secret Manager", $descr="Almacena secretos de todos los servicios: credenciales DB · API keys · client secrets. Acceso via Service Account (IAM). Rotación automática · audit log.", $tags="", $link="")
System(PowerBIService, "Power BI Service", $descr="Servicio de BI en la nube. Embed API · REST API Dashboards · Reports · Datasets", $tags="", $link="")
System(Datalake, "Datalake", $descr="Repositorio analítico y estructurado de datos tabulares. Recibe información transformada por los ETL.", $tags="", $link="")
System(CloudDataFusion, "Cloud Data Fusion", $descr="Ingesta al datalake corporativo", $tags="", $link="")
System(SalesForce, "SalesForce", $descr="Dato maestro de los clientes", $tags="", $link="")
System(SAPERP, "SAP ERP", $descr="ERP de terpel", $tags="", $link="")
System(ZENPUT, "ZENPUT", $descr="Sistema corporativo referenciado en la página L0 sin descripción en el Draw.io (pendiente de confirmar por Arquitectura).", $tags="", $link="")
System(GuruSoft, "GuruSoft", $descr="Servicio de facturacion", $tags="", $link="")
System(DynatraceTenantTerpel, "Dynatrace (Tenant Terpel)", $descr="Fuente unica de verdad corporativa (Politica de Observabilidad Terpel). APM . Infra Monitoring . DEM . RASP . Business Analytics.", $tags="", $link="")

System_Boundary("Portal_boundary", "Portal", $tags="") {
  ContainerDb(Portal.Search, "Search", $techn="Elasticsearch", $descr="Full-text Wiki · Apps", $tags="", $link="")
  Container(Portal.Storage, "Storage", $techn="Cloud Storage (GCS)", $descr="Adjuntos Wiki · MFE builds", $tags="", $link="")
  ContainerDb(Portal.Database, "Database", $techn="Firestore", $descr="Páginas Wiki · Versiones", $tags="", $link="")
  ContainerDb(Portal.CloudSQLPostgreSQL, "Cloud SQL (PostgreSQL)", $techn="Database", $descr="Usuarios · Roles · Registry", $tags="", $link="")
  ContainerDb(Portal.MemorystoreRedis, "Memorystore (Redis)", $techn="Cache", $descr="Sesiones · Tokens · Queries", $tags="", $link="")
  Container(Portal.SvcWiki, "Svc: Wiki", $techn="Cloud Run", $descr="CRUD páginas · Versiones Búsqueda Elasticsearch", $tags="", $link="")
  Container(Portal.SvcUsuariosAuth, "Svc: Usuarios / Auth", $techn="Cloud Run", $descr="Roles · Permisos · Perfil Sincroniza con Azure AD", $tags="", $link="")
  Container(Portal.BackendHUBWeb, "Backend — HUB Web", $techn="Node.js / FastAPI · Cloud Run", $descr="Orquesta todas las llamadas del Shell y los remotes MFE. Agrega: Wiki API + Apps Registry + User Profile Valida JWT · Propaga tokens Auto-scaling · Pay-per-use", $tags="", $link="")
  Container(Portal.HUBFront, "HUB Front", $techn="React + Vite · SPA", $descr="App contenedora MFE. Orquesta routing global, layout, navbar. Carga remotes MFE según módulo. Inyecta JWT a todos los remotes. Deploy: CDN Cloudflare + GCS", $tags="", $link="")
  Container(Portal.CloudMonitoring, "Cloud Monitoring", $techn="GCP Cloud Monitoring", $descr="Métricas de todos los Cloud Run. Alertas: errores · latencia · anomalías. Dashboards operacionales. Uptime checks · SLO tracking.", $tags="", $link="")
  Container(Portal.CloudLogging, "Cloud Logging", $techn="GCP Cloud Logging", $descr="Logs centralizados de todos los servicios. Audit logs: IAP · Secret Manager · KMS. Request logs: BFF · Svc · Federation Bridge. Retención configurable · alertas.", $tags="", $link="")
  Container(Portal.PortalesRemoteModulo, "Portales Remote Modulo", $techn="React + Vite · Module · Cloud run", $descr="Catálogo de herramientas internas. Lanza apps: iframe / sub-remote Estado: prod / poc / draft / deprecated RBAC por herramienta · Registry API", $tags="", $link="")
  Container(Portal.FederationBridge, "Federation Bridge", $techn="React + Vite · Module · Cloud run", $descr="Adaptador de tokens para portales externos. SAML 2.0 assertion · OIDC token exchange On-Behalf-Of flow · SSO silencioso Propaga sesión sin re-login", $tags="", $link="")
  Container(Portal.SvcPowerBIProxy, "Svc: Power BI Proxy", $techn="Cloud Run · FastAPI", $descr="Genera embed tokens via AAD. Proxy seguro a Power BI REST API. Controla acceso por rol/workspace.", $tags="", $link="")
  Container(Portal.BackendHUBWebMóvil, "Backend — HUB Web (Móvil)", $techn="Node.js / FastAPI / Python · Cloud Run", $descr="Mismo patrón que BFF Web. Orquesta Wiki API + Registry + Perfil. Payload liviano/paginado para móvil. Valida JWT · Propaga tokens. Instancia Cloud Run independiente.", $tags="", $link="")
  Container(Portal.SvcAnalitica, "Svc: Analitica", $techn="Cloud Run", $descr="Entrega y consulta de data analitica", $tags="", $link="")
  Container(Portal.SvcNotificacion, "Svc: Notificacion", $techn="Cloud Run", $descr="Gestiona notificaciones", $tags="", $link="")
  Container(Portal.SvcPagos, "Svc: Pagos", $techn="Cloud Run", $descr="Gestiona pagos", $tags="", $link="")
  ContainerQueue(Portal.Colademensajeria, "Cola de mensajeria", $techn="Pub/Sub", $descr="Serivico para subir las solicitudes asincronas", $tags="", $link="")
  ContainerDb(Portal.MemorystoreRedisfree, "Memorystore (Redis free)", $techn="Cache", $descr="Sesiones · Tokens · Queries", $tags="", $link="")
  Container(Portal.AppMóvil, "App Móvil", $techn="iOS / Android · App Store / Play Store", $descr="NO se despliega en GCP. Corre en el dispositivo del usuario. Se distribuye vía tiendas de apps. Consume su backend (BFF Mobile) por HTTPS.", $tags="", $link="")
  Container(Portal.OTelCollector, "OTel Collector", $techn="OpenTelemetry Collector . Cloud Run", $descr="Recibe OTLP (gRPC/HTTP) de todos los servicios. Enmascara datos personales antes de exportar. Exporta trazas, metricas y logs a Dynatrace. Materializa la estrategia 'OTel First' de la politica.", $tags="", $link="")
}

Rel(Portal.HUBFront, Portal.BackendHUBWeb, "REST/JSON · JWT", $techn="", $tags="", $link="")
Rel(Portal.PortalesRemoteModulo, Portal.BackendHUBWeb, "REST · JWT", $techn="", $tags="", $link="")
Rel(Portal.BackendHUBWeb, ApiGee, "gRPC / REST", $techn="", $tags="", $link="")
Rel(Portal.SvcUsuariosAuth, Portal.CloudSQLPostgreSQL, "SQL", $techn="", $tags="", $link="")
Rel(Portal.SvcWiki, Portal.Database, "Firestore SDK", $techn="", $tags="", $link="")
Rel(Portal.SvcWiki, Portal.Search, "Elasticsearch API", $techn="", $tags="", $link="")
Rel(Portal.BackendHUBWeb, Portal.MemorystoreRedis, "Redis SDK", $techn="", $tags="", $link="")
Rel(EntraIDCIAM, Portal.SvcUsuariosAuth, "OIDC / SCIM sync", $techn="", $tags="", $link="")
Rel(Portal.SvcWiki, Portal.Storage, "Almacen de data no estructurada", $techn="", $tags="", $link="")
Rel(Portal.HUBFront, IdentityAwareProxyIAP, "Verifica Autenticacion", $techn="", $tags="", $link="")
Rel(ZTNA, GlobalLoadBalancer, "Sync Red Corporativa Privada", $techn="", $tags="", $link="")
Rel(GlobalLoadBalancer, Portal.HUBFront, "HTTPS · TLS 1.3", $techn="", $tags="", $link="")
