Rel(Volarte.AppMóvil, ZTNANetskope, "Túnel gestionado (MDM / posture Intune)", $techn="ZTNA · mTLS", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.Memorystore, "Cache de decisión de autorización", $techn="Redis RESP · TLS (in-transit encryption)", $tags="", $link="")
Rel(Volarte.BFFWeb, GCPSecretManager, "Lee secretos (IAM Service Account)", $techn="gRPC · TLS · IAM", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcUsuariosAuth, "Consulta roles / mapping", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcDatosMaestros, "Consulta datos maestros", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcComercial, "Consulta elegibilidad, precio y crédito", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcOperación, "Consulta estado de operación / turnos", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.SvcAsignaciónOptimización, "Solicita recomendación de asignación", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.CloudSQL, "Consultas varias (Proxy SQL)", $techn="Cloud SQL Auth Proxy · TLS", $tags="", $link="")
Rel(Volarte.BFFWeb, Volarte.ColadeMensajería, "Publica resolución del supervisor (HU-050)", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFWeb, OTelCollector, "Exporta trazas, métricas y logs", $techn="OTLP gRPC · TLS · IAM Invoker", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.Memorystore, "Dedupe por UUID de acción", $techn="Redis RESP · TLS (in-transit encryption)", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.CloudSQL, "Escribe / lee tablas de Sincronización", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.DocumentosGCS, "Resumable upload de fotos / firma", $techn="GCS JSON API · HTTPS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.ColadeMensajería, "Publica cierre de operación", $techn="Pub/Sub API · gRPC TLS", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.SvcOperación, "Obtiene turnos / estado operativo", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
Rel(Volarte.BFFMóvil, Volarte.SvcDatosMaestros, "Obtiene catálogos versionados", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")
