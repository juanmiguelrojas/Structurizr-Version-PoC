Rel(Volarte.SvcComercial, Volarte.CloudSQL, "Lee / escribe estado comercial", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.SvcDatosMaestros, Volarte.CloudSQL, "Lee / escribe datos maestros", $techn="Cloud SQL Connector · TLS", $tags="", $link="")
Rel(Volarte.SvcDatosMaestros, Salesforce, "Sincroniza dato maestro de clientes", $techn="REST · HTTPS · OAuth2", $tags="", $link="")
Rel(Volarte.SvcAsignaciónOptimización, Skypredict, "Solicita recomendación (degradación controlada)", $techn="REST · HTTPS", $tags="", $link="")
Rel(Volarte.SvcAsignaciónOptimización, Volarte.SvcOperación, "Lee estado dinámico de equipos / operadores", $techn="HTTPS · ID Token (IAM Invoker)", $tags="", $link="")

